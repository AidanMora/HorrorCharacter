<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.cell.TextFieldListCell?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PrimaryController">
   <children>
      <ListView fx:id="listView"
                editable="true"
                layoutX="12.0"
                layoutY="12.0"
                onEditCommit="#onItemEditCommit"
                prefHeight="254.0"
                prefWidth="450.0">
          <cellFactory>
              <TextFieldListCell fx:factory="forListView"/>
          </cellFactory>
      </ListView>
   </children>
</AnchorPane>
